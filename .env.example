# ============================================================
# Fintech E2E Visual Testing — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---------------------------
# Application URLs
# ---------------------------

# Base URL of the application under test
BASE_URL=http://localhost:3000

# Base URL for API requests (used in API-level setup/teardown)
API_BASE_URL=http://localhost:3001/api

# ---------------------------
# Test User Credentials
# ---------------------------

# Email address of the test user account
TEST_USER_EMAIL=testuser@fintech-demo.com

# Password for the test user account
TEST_USER_PASSWORD=SuperSecureP@ssw0rd!

# ---------------------------
# Visual Testing Tokens
# ---------------------------

# Percy visual testing token (obtain from https://percy.io)
PERCY_TOKEN=your_percy_token_here

# Chromatic project token (obtain from https://www.chromatic.com)
CHROMATIC_PROJECT_TOKEN=your_chromatic_project_token_here

# ---------------------------
# CI / Misc
# ---------------------------

# Set to "true" in CI environments to enable CI-specific behaviour
CI=false

# Headless mode override (true = headless, false = headed)
HEADLESS=true
